---
import '../styles/global.css'; //
const { locale, title } = Astro.props;
const t = await import(`../i18n/${locale}.json`);
const otherLang = locale === 'es' ? 'en' : 'es';

const base = import.meta.env.BASE_URL;

const currentPath = Astro.url.pathname
  .replace(base, '')
  .replace(new RegExp(`^${locale}(?=/|$)`), '')
  .replace(/^\/+|\/+$/g, '');

const languageUrl = `${base}${otherLang}/${currentPath}`;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | CAIS</title>

 <!-- CÓDIGO DEL FAVICON AQUÍ -->
  <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon-96x96.png`} sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
  <meta name="apple-mobile-web-app-title" content="CAIS" />
  <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
  <!-- FIN DEL CÓDIGO DEL FAVICON -->

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container py-2">
      <a class="navbar-brand d-flex align-items-center fw-bold" href={`${import.meta.env.BASE_URL}${locale}/`}>
        <img src={`${import.meta.env.BASE_URL}logo.webp`} alt="CAIS Logo" class="me-2" style="height: 40px; width: auto;">
        <span style="margin-top: 4px;">CAIS</span>
      </a>
      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link" href="#portfolio">{t.nav.portfolio}</a>
        <a class="nav-link" href="#services">{t.nav.services}</a>
        <a class="nav-link" href="#contact">{t.nav.contact}</a> <!-- Si no lo tenías, agrégalo -->
        
        <!-- Botón de cambio de idioma -->
        <a class="nav-link text-primary ms-3 fw-bold" href={languageUrl}>
          {otherLang.toUpperCase()}
        </a>
      </div>
    </div>
  </nav>

  <slot />

  <!-- Footer -->
  <footer class="text-center py-4 border-top border-dark">
    <div class="container">
      <a href="https://github.com/orgs/CAIS-Official/repositories" class="text-white me-3" target="_blank" rel="noopener">
        <i class="bi bi-github fs-4"></i>
      </a>
      <a href="https://www.linkedin.com/company/143979340" class="text-white me-3" target="_blank" rel="noopener">
        <i class="bi bi-linkedin fs-4"></i>
      </a>
      <a href="https://www.instagram.com/cais.dev" class="text-white" target="_blank" rel="noopener">
        <i class="bi bi-instagram fs-4"></i>
      </a>
      <p class="mt-3 mb-0 small text-secondary">CAIS - Code and AI Solutions</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>