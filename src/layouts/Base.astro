---
// src/layouts/Base.astro
const { locale, title } = Astro.props;
const t = await import(`../i18n/${locale}.json`);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | CAIS</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <!-- Navbar simple -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href={`/${locale}/`}>CAIS</a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href={`/${locale}/`}>{t.nav.home}</a>
        <a class="nav-link" href={`/${locale}/servicios`}>{t.nav.services}</a>
      </div>
    </div>
  </nav>

  <!-- Contenido de la página -->
  <slot />

  <!-- Footer con tus redes -->
  <footer class="bg-dark text-white text-center py-4 mt-5">
    <div class="container">
      <a href="https://github.com/orgs/CAIS-Official/repositories" class="text-white me-3" target="_blank" rel="noopener">
        <i class="bi bi-github fs-4"></i>
      </a>
      <a href="https://www.linkedin.com/company/143979340" class="text-white me-3" target="_blank" rel="noopener">
        <i class="bi bi-linkedin fs-4"></i>
      </a>
      <a href="https://www.instagram.com/cais.dev" class="text-white" target="_blank" rel="noopener">
        <i class="bi bi-instagram fs-4"></i>
      </a>
      <p class="mt-3 mb-0 small text-secondary">CAIS - Code and AI Solutions</p>
    </div>
  </footer>

  <!-- Bootstrap JS (opcional, solo si usas componentes interactivos) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>