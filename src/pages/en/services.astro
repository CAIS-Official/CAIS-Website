---
// src/pages/es/servicios.astro
import Base from '../../layouts/Base.astro';
---

<Base locale="es" title="Servicios">
  <section class="py-5">
    <div class="container">
      <h1 class="text-center mb-5">Nuestros Servicios</h1>
      <div class="row g-4">
        <!-- Aquí irán las 3 cards: Landing, Comercial, Business -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title">Landing Page</h5>
              <p class="card-text">Una sola página enfocada en conversión.</p>
              <p class="fw-bold text-primary">$150 - $250 USD</p>
            </div>
          </div>
        </div>
        <!-- ... las otras dos cards -->
      </div>
    </div>
  </section>
</Base>