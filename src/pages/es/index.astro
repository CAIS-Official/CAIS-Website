---
// src/pages/es/index.astro
import Base from '../../layouts/Base.astro';
const t = await import('../../i18n/es.json');
---

<Base locale="es" title="Inicio">
  <!-- Hero -->
  <section class="py-5 text-center bg-light">
    <div class="container">
      <h1 class="display-4 fw-bold">{t.hero.title}</h1>
      <p class="lead text-muted">{t.hero.subtitle}</p>
      <a href="/es/servicios" class="btn btn-primary btn-lg mt-3">{t.hero.cta}</a>
    </div>
  </section>

  <!-- Por qué elegirnos -->
  <section class="py-5">
    <div class="container">
      <h2 class="text-center mb-5">{t.why.title}</h2>
      <div class="row g-4">
        <div class="col-md-4 text-center">
          <i class="bi bi-speedometer2 fs-1 text-primary"></i>
          <h4 class="mt-3">{t.why.item1_title}</h4>
          <p class="text-muted">{t.why.item1_desc}</p>
        </div>
        <div class="col-md-4 text-center">
          <i class="bi bi-translate fs-1 text-primary"></i>
          <h4 class="mt-3">{t.why.item2_title}</h4>
          <p class="text-muted">{t.why.item2_desc}</p>
        </div>
        <div class="col-md-4 text-center">
          <i class="bi bi-shield-check fs-1 text-primary"></i>
          <h4 class="mt-3">{t.why.item3_title}</h4>
          <p class="text-muted">{t.why.item3_desc}</p>
        </div>
      </div>
    </div>
  </section>
</Base>