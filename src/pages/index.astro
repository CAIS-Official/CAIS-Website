---
// src/pages/index.astro
// Usamos el base para que funcione en GitHub Pages
const base = import.meta.env.BASE_URL;
const redirectUrl = `${base}en/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Redirecting... | CAIS</title>
  
  <!-- Aquí usamos la variable que calculamos arriba -->
  <meta http-equiv="refresh" content={`1;url=${redirectUrl}`} />
  
  <style>
    body {
      background-color: #050B14;
      color: #E2E8F0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
      text-align: center;
    }
    .loader {
      width: 50px;
      height: 50px;
      border: 5px solid rgba(56, 189, 248, 0.2);
      border-top-color: #38BDF8;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-bottom: 20px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    a {
      color: #38BDF8;
      text-decoration: none;
      font-weight: bold;
    }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="loader"></div>
  <h1>Redirecting...</h1>
  <!-- También actualizamos el enlace de respaldo -->
  <p>If you are not redirected automatically, <a href={redirectUrl}>click here</a>.</p>
</body>
</html>